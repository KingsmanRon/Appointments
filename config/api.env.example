APP_ENV=development
RELEASE_SHA=local
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=ES256
TENANT_DATABASE_CREDENTIALS=REPLACE_WITH_PRIVATE_JSON_MAP
DB_POOL_GLOBAL_MAX=10
DB_POOL_TENANT_MAX=1
STORAGE_BACKEND_SECRET=REPLACE_WITH_SECRET
STORAGE_QUARANTINE_BUCKET=access-quarantine
STORAGE_ACCEPTED_BUCKET=access-accepted
ALLOWED_ORIGINS=http://localhost:3000
CONNECTOR_VERIFY_PUBLIC_KEYS=REPLACE_WITH_BOUND_PUBLIC_KEY_MAP
CONNECTOR_TOKEN_ISSUER=access_connector
CORE_INTERNAL_AUDIENCE=access_core
IDENTITY_HMAC_KEYS_BY_ORGANISATION=REPLACE_WITH_PRIVATE_VERSIONED_KEY_MAP
EXTRACTION_MODE=local
EXECUTION_ENABLED=false
REAL_PATIENT_DATA_ENABLED=false
